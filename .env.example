# SetList Environment Configuration
# Copy this file to .env and adjust values as needed.
# Most settings are configured inside the app (Settings page).

# Default music directory (used on first run if not set in the app)
MUSIC_DIR=~/Music

# Directory for configuration, database, and logs
CONFIG_DIR=~/.setlist

# Backend HTTP port (loopback only — never exposed to the network)
PORT=5050

# Audio file extensions to scan (comma-separated)
SCAN_EXTENSIONS=mp3,flac,wav,m4a,aac,ogg

# AcoustID Application API key for audio fingerprint identification
# Get one at: https://acoustid.org/my-applications
ACOUSTID_API_KEY=

# CORS allowed origins (comma-separated). Loopback + Tauri webview only.
ALLOWED_ORIGINS=http://127.0.0.1:5050,http://127.0.0.1:5173,http://127.0.0.1:8080,tauri://localhost
